          "outcome": "ok"
        },
        {
          "source": "query_rewriter",
          "target": "finish_task",
          "outcome": "error"
        },
        {
          "source": "research_agent",
          "target": "source_validator",
          "outcome": "ok"
        },
        {
          "source": "research_agent",
          "target": "finish_task",
          "outcome": "error"
        },
        {
          "source": "source_validator",
          "target": "ingest_sources",
          "outcome": "accepted"
        },
        {
          "source": "source_validator",
          "target": "research_report",
          "outcome": "none"
        },
        {
          "source": "source_validator",
