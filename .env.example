# Copy to .env, paste an Anthropic API key below, and run `docker compose up -d`.
# No AWS account needed: embeddings run inside the app, and the fictional
# demo documents in data/demo are loaded once. Then open
# http://localhost:18000 (the first start builds the image and downloads a
# 130 MB embedding model, so give it a few minutes).

# Database password for the internal pgvector container (never published
# on a host port). Change it before you store anything real.
POSTGRES_PASSWORD=change-me

# Optional services: demo loads data/demo; ollama runs Ollama in Docker.
COMPOSE_PROFILES=demo

# ---- Chat model: bedrock | anthropic | openai | ollama ----
# Answers, guardrails and evaluators all use it. Key: console.anthropic.com
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL defaults to claude-haiku-4-5.
# LLM_MODEL=

# OpenAI instead:
# LLM_PROVIDER=openai
# LLM_MODEL=
# OPENAI_API_KEY=

# Fully offline with Ollama (no key). Small models are poor guardrail
# classifiers: up to 7B they blocked most legitimate travel questions in
# testing. Try 14B or larger (untested), ideally on a native Ollama (it uses
# the GPU on a Mac):
#   ollama pull qwen2.5:14b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b
# Or Ollama in Docker (CPU only): add ollama to COMPOSE_PROFILES, then
# OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_PULL=qwen2.5:14b

# ---- Embeddings: bedrock | openai | ollama | local ----
# local runs BAAI/bge-small-en-v1.5 inside the app: free and offline.
# Changing this once documents are stored needs:
#   docker compose run --rm worker python -m reindex_embeddings
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=
# EMBEDDING_DIM=

# ---- Amazon Bedrock (LLM_PROVIDER / EMBEDDING_PROVIDER=bedrock) ----
# BEDROCK_REGION=eu-west-2
# BEDROCK_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Multi-agent flows run locally on the chat model above. To run them on a
# Bedrock AgentCore harness (agentcore-kb/) instead, set its ARN:
# AGENT_HARNESS_ARN=
# AGENT_RUNTIME=agentcore

# ---- Browser security ----
# Admins are signed out after this many minutes without using the app
# (default 60; everyone's sign-in lasts at most 12 hours).
# ADMIN_IDLE_MINUTES=60
# State-changing requests from other sites are refused. Origins allowed
# besides the app's own (comma-separated), e.g. behind a proxy that rewrites
# the Host header:
# ALLOWED_ORIGINS=https://ingenmind.example.com

# ---- Usage limits (per user; 0 = no limit) ----
# Over a limit, a question gets "wait N seconds/hours" (HTTP 429). Admins can
# set someone's own limits on the Users page. Days are UTC days.
# LIMIT_QUESTIONS_PER_MINUTE=10
# LIMIT_TOKENS_PER_DAY=500000
# ADMIN_QUESTIONS_PER_MINUTE=30
# ADMIN_TOKENS_PER_DAY=5000000
# Everyone together per day (0 = no cap): over it, questions get "busy".
# GLOBAL_TOKENS_PER_DAY=0

# ---- Model routing (optional) ----
# Tried in order when the chat model fails for a reason that isn't the request's:
# LLM_FALLBACK=anthropic:claude-haiku-4-5,openai:gpt-4.1-mini
# A model of their own for these jobs (provider:model):
# LLM_FOR_GUARDRAILS=anthropic:claude-haiku-4-5
# LLM_FOR_EVALUATORS=
# LLM_FOR_REWRITING=

# ---- Answer cache (checked answers reused for the same question) ----
# ANSWER_CACHE=true
# ANSWER_CACHE_SIMILARITY=0.97
# ANSWER_CACHE_HOURS=24

# ---- Research agent web search (optional) ----
# TAVILY_API_KEY=

# ---- Scraping ----
# Pages are only fetched from public addresses (never the database, Langfuse or
# the cloud metadata service). true also allows private networks, for an
# intranet knowledge base; loopback and link-local stay refused.
# FETCH_ALLOW_PRIVATE=

# ---- Langfuse tracing (optional) ----
# Start it with: docker compose -f docker-compose.yml -f docker-compose.langfuse.yml up -d
# and set the LANGFUSE_INIT_* and secret values described in the README.

# ---- Sign-in (app/auth.py) ----
# dev: a development sign-in (pick a user, localhost only); the first visit
# creates the first admin. oidc: any OpenID Connect provider (Cognito,
# Google, Microsoft Entra, Keycloak, Auth0…); register the redirect URI
# http://localhost:18000/auth/callback with it. The app never stores passwords.
AUTH_MODE=dev
# Signs the sign-in cookie; required for oidc. Generate: openssl rand -base64 32
# SESSION_SECRET=
# People who may sign in as admins (others need an admin to add them):
# ADMIN_EMAILS=you@example.com
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Google
# The provider's own logout URL; wins over discovery (Cognito needs it):
# OIDC_LOGOUT_URL=https://<domain>.auth.<region>.amazoncognito.com/logout?client_id={client_id}&logout_uri={return}
# Behind HTTPS: SESSION_COOKIE_SECURE=1
