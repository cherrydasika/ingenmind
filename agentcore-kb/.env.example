# Copy to .env and fill in. Never commit .env.

# PostgreSQL with pgvector (the RAG app's database; table rag_chunks)
PGHOST=localhost
PGPORT=5432
PGDATABASE=rag
PGUSER=kb_reader
PGPASSWORD=your_password
# Or, instead of PGPASSWORD, the SSM SecureString holding it (used on AgentCore Runtime)
# PGPASSWORD_PARAMETER=/rag-systems/prod/agentcore-kb-pg-password

# Region of the database, MCP server runtime, gateway and harness
AWS_REGION=eu-west-2

# IAM role the harness assumes, and the gateway in front of the MCP server
HARNESS_ROLE_ARN=
GATEWAY_ARN=

# Filled in after running agent/deploy.py
HARNESS_ARN=
