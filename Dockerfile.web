FROM python:3.11-slim

WORKDIR /app

COPY requirements-web.txt /app/requirements-web.txt
# Debian's security updates, then the app's packages. pip itself is removed
# afterwards: the app never installs anything at run time, and pip vendors
# its own (older) copies of urllib3, msgpack and setuptools.
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir -r /app/requirements-web.txt \
    && pip uninstall -y pip

# The app's code, so the image runs on its own (the release install). The dev
# and EC2 compose files bind-mount the checkout over these paths.
COPY app /app
COPY dags /app/dags
COPY web /web
COPY data/demo /data/demo
COPY data/urls.example.json /data/urls.example.json

# The release (v1.0.0 → 1.0.0), set by the release workflow; "dev" otherwise.
ARG VERSION=dev
ENV PYTHONUNBUFFERED=1 INGENMIND_APP_VERSION=$VERSION
EXPOSE 8000
CMD ["uvicorn", "web_api:app", "--app-dir", "/app", "--host", "0.0.0.0", "--port", "8000"]
